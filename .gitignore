# Build trees, logs, packages
/build-*/
/logs/
/dist/
/backups/

# Project-local toolchain (rebuilt by toolchain\*.cmd) and agent worktrees
/toolchain/
/.claude/worktrees/
/.claude/settings.local.json

# Copyrighted game data and decompiled output: never commit
/Data/
/extracted/
/re_reference/

# Probe captures and traces (many GB)
/tools/probe_mod/**/out/
# Q4 parity harness reports and port runs (tools/parity/README.md)
/tools/parity/out/

# Roadmap data lives in its own repository
/roadmap-store/

# Misc
__pycache__/
*.pyc
*.tmp
*.pkl
*.trace
/tools/probe_mod/**/*.dat

# Test output written next to goldens, probe-kit build products and run logs
*.actual
/tools/probe_mod/**/bin/
/tools/probe_mod/**/*.log
/tools/probe_mod/**/selftest/work/
# Generated file-priority probe payloads (build_probe.py writes them; see tools/probe_mod/README.md)
/tools/probe_mod/v2/Mods/
/tools/probe_mod/v2/OPTIONAL_*/
/tools/probe_mod/probeE/Mods/
/tools/probe_mod/probeE/OPTIONAL_*/

# Command Center launcher build output (launcher\cargo.cmd)
/launcher/target/
