          "do": "wait_window",
          "s": 180
        },
        {
          "do": "fit_window"
        },
        {
          "do": "expect_like",
          "ref": "main_menu",
          "timeout": 150,
          "poll": 3,
          "nudge_key": "ESC",
          "label": "skip intro movies"
        },
        {
          "do": "fit_window",
          "gap": 2
        },
        {
          "do": "expect_like",
          "ref": "main_menu",
          "timeout": 20
        },
        {
          "do": "shot",
          "label": "main_menu"
