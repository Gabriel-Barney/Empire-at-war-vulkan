  {
   "id": "K",
   "title": "Space skirmish at Kuat with Thrawn's Star Destroyer (Admonitor) - the main scene",
   "modes": [
    "dxvk",
    "renderdoc",
    "apitrace"
   ],
   "answers": [
    "blue cast on the lit Thrawn SD / Colorization default",
    "heat target 0x80 bias",
    "engine cull mode",
    "space frame order (background scene, depth-only clear, ships)",
    "shadow-volume draws in space (SPACE_AND_OPEN C.4)",
    "skydome rotation order at Kuat (C.3)",
    "planet backdrop (D.2/D.7)"
   ],
   "manual": [
    "Main menu > Single Player > Skirmish Battles > Space Battle.",
    "Pick the map Kuat, play as the Empire against one AI, set Starting Credits to the maximum, then Start Game.",
    "Select your space station and build Thrawn's Star Destroyer (Admonitor, 6200 credits, 40 s). Build a few more ships too.",
    "Fly the Admonitor so it is lit by the sun and the planet is in the background. Zoom in so it fills about a third of the screen.",
    "RenderDoc run: press F12 once here (Thrawn close-up), once while ships fire/explode (heat), once zoomed out (whole battle).",
    "DXVK run: wait for a screenshot (every 15 s), toggle Shadow detail low/high in Options, wait again.",
    "apitrace run: as soon as the Admonitor is on screen, keep it there 10 seconds, then quit the game (Esc > Quit Game). Keep the whole session short."
   ],
   "ui_steps": [
    {
     "screen": "intro movies / splash",
     "do": "press Escape (or click) to skip each logo movie",
     "expect": "main menu with 'Single Player', 'Multiplayer', 'Options'"
    },
    {
     "screen": "main menu",
     "do": "click 'Single Player'",
     "expect": "single-player menu listing 'Skirmish Battles'"
    },
    {
     "screen": "single-player menu",
     "do": "click 'Skirmish Battles'",
     "expect": "'Skirmish Battle Setup' screen"
    },
    {
     "screen": "Skirmish Battle Setup",
     "do": "click 'Space Battle'",
     "expect": "map list shows space maps"
    },
    {
     "screen": "Skirmish Battle Setup",
     "do": "click the map 'Kuat' in the map list",
     "expect": "Kuat preview shown"
    },
    {
     "screen": "Skirmish Battle Setup",
     "do": "set your faction to Empire; make sure exactly one AI opponent is present",
     "expect": "player row shows Empire"
    },
    {
     "screen": "Skirmish Battle Setup",
     "do": "drag the 'Starting Credits' slider to the maximum",
     "expect": "credits >= 6200"
    },
    {
     "screen": "Skirmish Battle Setup",
     "do": "click 'Start Game'",
     "expect": "loading screen, then the space battle"
    },
    {
     "screen": "space battle",
     "do": "click your space station; in the build bar click the Thrawn / Admonitor icon (i_button_thrawn)",
     "expect": "build queue shows the Admonitor (40 s)"
    },
    {
     "screen": "space battle",
     "do": "wait ~45 s; double-click the Admonitor (or its unit button) to centre the camera; zoom in with the mouse wheel",
     "expect": "Thrawn's SD fills ~1/3 of the screen, planet visible behind it"
    },
    {
     "screen": "space battle",
     "do": "TRIGGER kuat_thrawn (g1.py trigger --label kuat_thrawn)",
     "expect": "capture file in the run folder"
    },
    {
     "screen": "space battle",
     "do": "send ships toward the enemy; when weapons fire / ships explode TRIGGER kuat_heat",
     "expect": "capture file"
    },
    {
     "screen": "space battle",
     "do": "zoom out fully; TRIGGER kuat_wide",
     "expect": "capture file"
    },
    {
     "screen": "space battle",
     "do": "g1.py quit (or Esc > 'Quit Game' > confirm)",
     "expect": "game exits; kit restores and analyses"
    }
   ],
