{
  "permissions": {
    "allow": [
      "PowerShell(cmd /c tools\\land_on_dev.cmd)",
      "PowerShell(cmd /c \"tools\\land_on_dev.cmd\")",
      "PowerShell(.\\tools\\land_on_dev.cmd)",
      "PowerShell(& .\\tools\\land_on_dev.cmd)",
      "PowerShell(python -I tools\\worktree\\delete_merged_branch.py *)",
      "PowerShell(python -I tools/worktree/delete_merged_branch.py *)",
      "Bash(python -I tools/worktree/delete_merged_branch.py *)",
      "PowerShell(python -I tools\\worktree\\stop_tree_procs.py)",
      "PowerShell(python -I tools\\worktree\\stop_tree_procs.py *)",
      "PowerShell(python -I tools/worktree/stop_tree_procs.py)",
      "PowerShell(python -I tools/worktree/stop_tree_procs.py *)",
      "Bash(python -I tools/worktree/stop_tree_procs.py)",
      "Bash(python -I tools/worktree/stop_tree_procs.py *)",
      "PowerShell(python -I tools\\lint\\test_slot.py --status)",
      "PowerShell(python -I tools/lint/test_slot.py --status)",
      "Bash(python -I tools/lint/test_slot.py --status)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python -I -c \"import os,runpy,sys; p=os.path.join(os.environ.get('CLAUDE_PROJECT_DIR','.'),'tools','lint','check_string_literals.py'); sys.argv=[p,'--hook']; os.path.isfile(p) and runpy.run_path(p,run_name='__main__')\"",
            "timeout": 20
          }
        ]
      }
    ]
  }
}
