# Int-final: cross-build check of an alamo_game smoke run. Compares the run's dumped per-tick CRC log (comment lines '#'
# ignored) and command recording (byte for byte) with the checked-in goldens (MSVC-generated; clang must match).
#   cmake -DACTUAL=<dir>/game_smoke_<name> -DGOLDEN=<testdata>/game_smoke_<name> -P compare_smoke.cmake
# No dumped files (no ALAMO_FOC_DATA: the smoke skipped) -> "skipped", success. Regenerate after an intended sim change:
# copy the MSVC build's <build>/smoke_out/game_smoke_<name>.crc / .rec over the goldens (tools\regen_goldens.cmd does it and
# stores the .crc as a checkpoint golden). -DHEADLESS=<alamo_headless> is needed only for a checkpoint golden (below).
if(NOT EXISTS "${ACTUAL}.crc")
  message(STATUS "smoke compare: ${ACTUAL}.crc not written (no game data): skipped")
  return()
endif()
# Checkpoint golden (ALAMO_CRC 2, docs/status/golden-checkpoints.md): only the golden's stored ticks are compared, by
# alamo_headless --compare (the same code as every --golden check). -DHEADLESS=<alamo_headless> is passed by the game
# CMake. A full golden (ALAMO_CRC 1) takes the exact line-by-line compare below.
file(STRINGS "${GOLDEN}.crc" _golden_head LIMIT_COUNT 1)
if(_golden_head MATCHES "^ALAMO_CRC 2")
  if(NOT HEADLESS OR NOT EXISTS "${HEADLESS}")
    message(FATAL_ERROR "smoke compare: ${GOLDEN}.crc is a checkpoint golden (ALAMO_CRC 2): pass -DHEADLESS=<alamo_headless>")
  endif()
  execute_process(COMMAND "${HEADLESS}" --compare "${GOLDEN}.crc" "${ACTUAL}.crc" RESULT_VARIABLE rc OUTPUT_VARIABLE cmp_out
                  ERROR_VARIABLE cmp_err)
  if(NOT rc EQUAL 0)
    message(FATAL_ERROR "smoke compare: CRC log differs from ${GOLDEN}.crc (checkpoint compare)
${cmp_out}${cmp_err}")
  endif()
  string(STRIP "${cmp_out}" _crc_summary)
else()
  function(_crc_lines path out)
    file(STRINGS "${path}" lines)
    set(kept "")
    foreach(l IN LISTS lines)
      if(NOT l MATCHES "^#")
        list(APPEND kept "${l}")
      endif()
    endforeach()
    set(${out} "${kept}" PARENT_SCOPE)
  endfunction()
  _crc_lines("${ACTUAL}.crc" a)
  _crc_lines("${GOLDEN}.crc" g)
  list(LENGTH a na)
  list(LENGTH g ng)
  if(NOT a STREQUAL g)
    set(i 0)
    set(first "")
    while(i LESS na AND i LESS ng)
      list(GET a ${i} la)
      list(GET g ${i} lg)
      if(NOT la STREQUAL lg)
        set(first "line ${i}: actual '${la}' golden '${lg}'")
        break()
      endif()
      math(EXPR i "${i} + 1")
    endwhile()
    message(FATAL_ERROR "smoke compare: CRC log differs from ${GOLDEN}.crc (${na} vs ${ng} lines) ${first}")
  endif()
  set(_crc_summary "${na} CRC lines")
endif()
execute_process(COMMAND ${CMAKE_COMMAND} -E compare_files "${ACTUAL}.rec" "${GOLDEN}.rec" RESULT_VARIABLE rc)
if(NOT rc EQUAL 0)
  message(FATAL_ERROR "smoke compare: command recording differs from ${GOLDEN}.rec")
endif()
message(STATUS "smoke compare: ${ACTUAL} identical to the golden (${_crc_summary})")
